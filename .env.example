# =========================================================================
# Supabase Edge Function secrets — server-side, never exposed to browser.
# Set these via the Supabase dashboard (Edge Functions → Secrets) or:
#   supabase secrets set APPS_SCRIPT_WEB_APP_URL=... APPS_SCRIPT_SHARED_SECRET=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the runtime.
# =========================================================================
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
APPS_SCRIPT_SHARED_SECRET=replace-with-the-same-value-set-in-apps-script-Code.gs

