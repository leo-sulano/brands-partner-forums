# VITE_CHECK_STATUS_URL  : "Check Status" button target. The working backend is the
#   self-hosted Selenium server (scripts/status_server.py) on an always-on PC with a
#   residential IP, exposed over HTTPS by an ngrok static domain so ALL users share it.
#   Production (Vercel): set to the ngrok static URL + /check-status.
#   Solo local dev: point it at http://localhost:5001/check-status instead.
# VITE_CHECK_STATUS_TOKEN: shared secret sent as `Authorization: Bearer <token>`. MUST
#   match CHECK_STATUS_TOKEN in scripts/.env on the host. Required once the tunnel is public.
VITE_CHECK_STATUS_URL=https://your-name.ngrok-free.dev/check-status
VITE_CHECK_STATUS_TOKEN=replace-with-a-long-random-string

