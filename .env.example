# VITE_AI_ASSISTANT_URL : floating AI assistant (gpt-4o-mini). The ai-assistant Edge
#   Function holds OPENAI_API_KEY (set via `supabase secrets set OPENAI_API_KEY=...`).
VITE_AI_ASSISTANT_URL=https://krxnupmhfiduduvvlumc.supabase.co/functions/v1/ai-assistant

# VITE_NOTIFY_BRAND_REMOVED_URL : fired when a brand's platform page is flagged "removed" in
#   the Edit Entry modal, to email every approved user. The notify-brand-removed Edge Function
#   sends via the Gmail API (not Resend — Resend's sandbox sender can only deliver to its own
#   account owner's email, which a real Gmail account isn't restricted by) and holds
#   GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, GMAIL_REFRESH_TOKEN, and GMAIL_SENDER_EMAIL
#   (set via `supabase secrets set GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=...
#   GMAIL_REFRESH_TOKEN=... GMAIL_SENDER_EMAIL=...`).
VITE_NOTIFY_BRAND_REMOVED_URL=https://krxnupmhfiduduvvlumc.supabase.co/functions/v1/notify-brand-removed

# VITE_CHECK_STATUS_URL  : "Check Status" button target. The working backend is the
#   self-hosted Selenium server (scripts/status_server.py) on an always-on PC with a
#   residential IP, exposed over HTTPS by an ngrok static domain so ALL users share it.
#   Production (Vercel): set to the ngrok static URL + /check-status.
#   Solo local dev: point it at http://localhost:5001/check-status instead.
# VITE_CHECK_STATUS_TOKEN: shared secret sent as `Authorization: Bearer <token>`. MUST
#   match CHECK_STATUS_TOKEN in scripts/.env on the host. Required once the tunnel is public.
VITE_CHECK_STATUS_URL=https://your-name.ngrok-free.dev/check-status
VITE_CHECK_STATUS_TOKEN=replace-with-a-long-random-string

# PORTAL_JWKS_URL / PORTAL_ISSUER / SSO_AUDIENCE : cross-dashboard SSO. The sso-callback
#   Edge Function verifies the central portal's signed token against these (set via
#   `supabase secrets set PORTAL_JWKS_URL=... PORTAL_ISSUER=... SSO_AUDIENCE=...`).
