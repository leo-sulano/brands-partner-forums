# Node / build
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Git worktrees (scratch, per superpowers:using-git-worktrees)
.worktrees/

# Env
.env
.env.local
.env.*.local

# Claude Code — local settings auto-accumulate approved commands that can embed
# secrets (keys, tokens). Keep them out of the repo.
.claude/settings.json
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scripts/*.log
scripts/logs/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# OS
Thumbs.db

# Supabase
supabase/.branches
supabase/.temp
supabase/functions/**/.env

.vercel

# Playwright MCP debug artifacts
.playwright-mcp/

# Superpowers scratch state (brainstorm sessions, plan state)
.superpowers/

# Source data already imported into the DB — not app code
csv/

# Stray temp files
*.tmp.*

# Separate project's checkout that happens to live inside this repo's
# directory tree — its own git repo, not a submodule of this one.
/BIF-Dashboard/
