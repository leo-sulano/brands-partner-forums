# Copy to scripts/.env and fill in.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret for the status server. When set, /check-status requires
# `Authorization: Bearer <this value>`. MUST equal VITE_CHECK_STATUS_TOKEN in the
# dashboard build. Required before exposing the server via a tunnel.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CHECK_STATUS_TOKEN=replace-with-a-long-random-string
