# Apps Script web app URL (the deployed URL from script.google.com)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared secret from Code.gs (SHARED_SECRET variable)
APPS_SCRIPT_SECRET=replace-with-your-secret

# Central Gmail inbox that receives all forwarded AG/CG emails
FORWARD_TO=leo@optinetsolutions.com

# Set to false to watch the browser while it runs (recommended for first run)
HEADLESS=false
